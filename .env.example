# API origin (no trailing slash). Default in code: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# If the browser blocks CORS, use the Vite proxy: set base URL to /api and restart dev server.
# VITE_API_BASE_URL=/api

# Optional: where the dev server proxies /api (default http://localhost:3000)
# VITE_DEV_PROXY_TARGET=http://localhost:3000
